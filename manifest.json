{
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["src/contentScript.js"]
    }
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ]
} 